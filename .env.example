NODE_ENV=development
PORT=3000
# Booking uses multi-document transactions — Mongo must be a replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/rukba?replicaSet=rs0&directConnection=true
# If your Mongo requires auth:
# MONGODB_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/rukba?authSource=admin&replicaSet=rs0&directConnection=true

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
QR_SECRET=change-me-qr-secret-min-32-chars
QR_TTL_MINUTES=1440
TRUST_PROXY=false
DEFAULT_PHONE_REGION=PS
AUTH_FAIL_ACCOUNT_MAX=5
AUTH_FAIL_ACCOUNT_LOCK_MS=900000
AUTH_FAIL_IP_MAX=20
AUTH_FAIL_IP_LOCK_MS=900000
AUTH_FAIL_WINDOW_MS=900000

# Cloudinary (profile images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional override; falls back to Cloudinary demo sample if empty
CLOUDINARY_DEFAULT_IMAGE_URL=https://res.cloudinary.com/demo/image/upload/w_400,h_400,c_fill,g_auto/sample.jpg
